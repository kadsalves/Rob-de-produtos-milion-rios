{
  "name": "olho-do-mercado",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12"},
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch src/server.js\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --env-file-if-exists=.env --watch src/server.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server.js",
    "user:create": "node --env-file-if-exists=.env src/create-user.js",
    "test": "node --test tests/api.test.js",
    "test:e2e": "node --test tests/browser.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4"
  }
}
